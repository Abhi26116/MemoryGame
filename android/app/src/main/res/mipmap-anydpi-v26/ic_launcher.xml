<?xml version="1.0" encoding="utf-8"?>
<!-- The real app icon (same art as the iOS AppIcon): the full-bleed bitmap is
     the background layer so launcher masks (circle/squircle) crop it exactly
     like iOS's rounded-rect crop; foreground stays transparent. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
